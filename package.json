{
  "name": "@kylebegeman/ledger",
  "version": "0.9.2",
  "description": "Repo-native change memory for humans and coding agents.",
  "type": "module",
  "keywords": [
    "changelog",
    "agents",
    "markdown",
    "ledger",
    "developer-tools"
  ],
  "homepage": "https://github.com/kylebegeman/ledger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylebegeman/ledger.git"
  },
  "bugs": {
    "url": "https://github.com/kylebegeman/ledger/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ledger": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./unstable": {
      "types": "./dist/unstable.d.ts",
      "import": "./dist/unstable.js"
    }
  },
  "files": [
    "assets",
    "!assets/readme",
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/*.md",
    "!docs/HANDOFF.md",
    ".ledger/templates/*.md"
  ],
  "scripts": {
    "build": "npm run build:reader && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:reader && vitest run --maxWorkers=4",
    "check": "npm run typecheck && npm test",
    "ledger:ci": "node dist/cli.js ci",
    "pack:dry-run": "npm pack --dry-run",
    "release:build": "npm run build && npm run pack:dry-run",
    "ci": "npm run check && npm run build && npm run ledger:ci && npm run pack:dry-run",
    "readme:check": "node scripts/readme-assets.mjs && git diff --exit-code -- assets/readme",
    "build:reader": "esbuild src/reader/runtime.ts --bundle --format=iife --platform=browser --target=es2022 --minify-whitespace --minify-syntax --outfile=dist/reader/runtime.js --log-level=warning && esbuild src/reader/styles.css --minify-whitespace --outfile=dist/reader/styles.css --log-level=warning"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^5.8.0",
    "vitest": "^5.0.1"
  },
  "license": "MIT"
}
